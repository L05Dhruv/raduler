# Copy to .env.local for local development.
#
# Both values are safe to publish: the anon key is a *publishable* key that grants
# nothing on its own, and Postgres Row-Level Security decides what each signed-in user
# may read or write. The `service_role` key bypasses RLS entirely — it must never be
# added to this file, the repository, or CI.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Leave empty locally. CI sets this to /raduler for the GitHub Pages project site.
NEXT_PUBLIC_BASE_PATH=
